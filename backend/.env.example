# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/lumiere

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15d
COOKIE_SECURE=false

CSRF_SECRET=replace-with-a-long-random-secret

ORDER_ACCESS_SECRET=replace-with-a-long-random-secret

MFA_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback
OAUTH_STATE_SECRET=replace-with-a-long-random-secret

CLIENT_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


ALLOW_MOCK_CHECKOUT=false


MASTER_KEY=

KEY_VERSION=1

ALERT_EMAIL=
ALERT_WEBHOOK_URL=
